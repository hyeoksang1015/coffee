# 이 파일을 .env.local 로 복사해 값을 채운다. 빌드 때 브라우저 코드에 들어가는 공개값만 둔다.
# Firebase 콘솔 → 프로젝트 설정 → 내 앱(웹) 의 firebaseConfig 값 (FLOWN 과 같은 프로젝트)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# 관리자 화면을 보여 줄 uid (쉼표로 여러 개). 실제 권한은 firestore.rules 가 검사한다.
NEXT_PUBLIC_ADMIN_UIDS=
# 토스페이먼츠 결제위젯 클라이언트 키. 비우면 결제 화면이 뜨지 않는다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm

# 서버 함수(functions/api)의 비밀값은 여기 두지 않는다.
# 로컬: .dev.vars / 배포: Cloudflare Pages 환경 변수(암호화)
#   TOSS_SECRET_KEY, FIREBASE_API_KEY, FIREBASE_PROJECT_ID, LW_SERVER_EMAIL, LW_SERVER_PASSWORD, ADMIN_UIDS
